# Copied to local/.env by `make setup`. Every value is a working dev default.

# ── Build ──
# GitHub token that can read the org's private dependencies (repo, read:packages).
# Leave empty when the apps have none.
GH_TOKEN=

# ── Postgres ──
POSTGRES_PASSWORD={{app}}_dev

# ── Web ──
AUTH_SECRET=dev-auth-secret-not-for-production
